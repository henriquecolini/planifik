// ─────────────────────────────────────────────────────────────────────────────
// Prisma Schema — Personal Finance App
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Required Tables ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Tables ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  groupMembers GroupMember[]
  items        Item[]
  itemEvents   ItemEvent[]
}

/// A Group is a shared workspace (e.g. "Family Finances", "Personal").
/// Multiple users can be members of the same group.
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GroupMember[]
  folders Folder[]
  items   Item[]
}

/// Membership record linking a User to a Group.
model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // "owner" | "member"
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

/// A Folder is a visual grouping inside a Group. Single level only.
model Folder {
  id              String   @id @default(cuid())
  groupId         String
  name            String
  icon            String   @default("📁") // emoji
  backgroundColor String   @default("#112038") // hex color
  position        Int      @default(0) // display order
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items Item[]
}

/// The type determines the sign convention and display behaviour.
enum ItemType {
  BILL // Monthly expense — always negative
  INCOME // Monthly income — always positive
  CREDIT_CARD // Account: tracks balance owed
  CHECKING_ACCOUNT // Account: tracks balance held
}

/// An Item is any financial entry: bill, income, credit card, or bank account.
model Item {
  id       String  @id @default(cuid())
  groupId  String
  folderId String? // optional folder grouping
  userId   String // who created / owns it

  title String
  type  ItemType

  /// Icon identifier — an emoji or a bank slug for accounts
  icon String @default("💰")

  /// Bank slug for CREDIT_CARD / CHECKING_ACCOUNT
  /// e.g. "nubank" | "itau" | "inter" | "caixa" | "c6" | "bradesco" | "santander" | "btg"
  bank String?

  // ─── Recurrence ────────────────────────────────────────────────────────────
  /// First month this item is active. Format: "YYYY-MM"
  startMonth String

  /// Last month this item is active. Format: "YYYY-MM".
  /// null = forever.
  /// When startMonth == endMonth, it's a one-time item.
  endMonth String?

  // ─── Due Date ──────────────────────────────────────────────────────────────
  /// Day of the month this item is due (1–31). Used for recurring items.
  dueDay Int?

  /// Default balance for all months if no ItemBalance exists.
  defaultAmount Decimal?

  /// Whether the dueDay refers to the next month's calendar.
  /// (e.g. Credit Card due on the 5th of next month).
  dueNextMonth Boolean @default(false)

  /// Full due date for one-time items.
  dueDate DateTime?

  /// Display order within its container (folder or unfiled). Lower = higher up.
  position  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group  Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  events     ItemEvent[]
  exceptions ItemException[]
  balances   ItemBalance[]
}

/// Tracks the actual balance of an item for a given month.
/// If no record exists, it defaults to 0.
model ItemBalance {
  id     String  @id @default(cuid())
  itemId String
  month  String // "YYYY-MM"
  amount Decimal

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, month])
}

/// Tracks when a user "pays" a bill, "receives" an income, or pays a credit card.
/// One event per item per month.
model ItemEvent {
  id     String @id @default(cuid())
  itemId String
  userId String

  /// The month this action occurred for. Format: "YYYY-MM"
  month String

  /// "paid" | "received"
  actionType String

  /// Optional: which account was used to pay/receive
  paymentMethod String? // "credit_card" | "checking_account" | "cash"
  paymentItemId String? // ID of the credit card or checking account Item used

  /// Whether the balance of paymentItemId was updated as a result
  balanceDeducted Boolean @default(false)

  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, month])
}

/// Marks a specific month as "skipped" for a recurring item.
/// Used when a user deletes "just this occurrence" of a recurring item.
model ItemException {
  id     String @id @default(cuid())
  itemId String
  month  String // "YYYY-MM"

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, month])
}
